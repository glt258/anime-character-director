{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_adherence.schema.json",
  "title": "VisualAdherenceReview",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "repairTarget": {
      "type": "object",
      "required": ["field", "ownership", "repair_importance", "repair_risk", "auto_repair_eligible"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "ownership": {"enum": ["HUMAN_EXPLICIT", "HUMAN_SELECTION", "SYSTEM_INVARIANT", "AI_RESOLVED", "SYSTEM_DEFAULT"]},
        "repair_importance": {"enum": ["CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"]},
        "repair_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "auto_repair_eligible": {"type": "boolean"},
        "manual_repair_available": {"type": "boolean"},
        "manual_repair_requested": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "repairTriggerDecision": {
      "type": "object",
      "required": ["disposition", "repair_required", "auto_repair_eligible", "manual_repair_available", "actionable_repair_targets", "informational_deviations"],
      "properties": {
        "disposition": {"enum": ["ACCEPT", "ACCEPT_WITH_DEVIATIONS", "REPAIR_RECOMMENDED", "REPAIR_REQUIRED", "BLOCKED"]},
        "repair_required": {"type": "boolean"},
        "auto_repair_eligible": {"type": "boolean"},
        "manual_repair_available": {"type": "boolean"},
        "repair_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "actionable_repair_targets": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}},
        "informational_deviations": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}}
      },
      "additionalProperties": false
    },
    "adherenceDisposition": {
      "type": "object",
      "required": ["strict_overall_result", "human_constraint_result", "system_invariant_result", "ai_design_fidelity_result", "disposition", "repair_required", "auto_repair_eligible", "actionable_repair_targets", "informational_deviations", "repair_trigger_decision"],
      "properties": {
        "strict_overall_result": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_EVALUABLE"]},
        "human_constraint_result": {"type": "string"},
        "system_invariant_result": {"type": "string"},
        "ai_design_fidelity_result": {"type": "string"},
        "blocking_failures": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}},
        "nonblocking_failures": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}},
        "repair_required": {"type": "boolean"},
        "auto_repair_eligible": {"type": "boolean"},
        "manual_repair_available": {"type": "boolean"},
        "repair_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "actionable_repair_targets": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}},
        "informational_deviations": {"type": "array", "items": {"$ref": "#/$defs/repairTarget"}},
        "disposition": {"enum": ["ACCEPT", "ACCEPT_WITH_DEVIATIONS", "REPAIR_RECOMMENDED", "REPAIR_REQUIRED", "BLOCKED"]},
        "disposition_source": {"type": "string"},
        "repair_trigger_decision": {"$ref": "#/$defs/repairTriggerDecision"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "actual_image",
    "overall_result",
    "field_results",
    "failure_types",
    "not_evaluable_fields",
    "anatomy_check",
    "repair_targets",
    "summary",
    "evidence_source",
    "prompt_hash",
    "manifest_fields"
  ],
  "properties": {
    "actual_image": {"type": "string", "minLength": 1},
    "overall_result": {"enum": ["PASS", "PARTIAL", "FAIL"]},
    "field_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "observed", "result", "failure_types", "rationale"],
        "properties": {
          "required": {},
          "observed": {},
          "result": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_EVALUABLE"]},
          "failure_types": {"type": "array", "items": {"type": "string", "pattern": "^TYPE [1-6]$"}},
          "rationale": {"type": "string"}
        }
      }
    },
    "failure_types": {"type": "array", "items": {"type": "string", "pattern": "^TYPE [1-6]$"}},
    "not_evaluable_fields": {"type": "array", "items": {"type": "string"}},
    "anatomy_check": {
      "type": "object",
      "required": ["result", "hand_anatomy_check", "foot_visibility_and_integrity_check"],
      "properties": {
        "result": {"enum": ["PASS", "FAIL", "NOT_EVALUABLE"]},
        "hand_anatomy_check": {"type": "object"},
        "foot_visibility_and_integrity_check": {"type": "object"}
      }
    },
    "repair_targets": {"type": "array", "items": {"type": "object"}},
    "summary": {"type": "string"},
    "evidence_source": {"type": "string"},
    "prompt_hash": {"type": ["string", "null"]},
    "manifest_fields": {"type": "array", "items": {"type": "string"}},
    "actual_image_hash": {"type": ["string", "null"]},
    "review_id": {"type": ["string", "null"]},
    "generation_id": {"type": ["string", "null"]},
    "adherence_disposition": {"anyOf": [{"$ref": "#/$defs/adherenceDisposition"}, {"type": "null"}]},
    "repair_trigger_decision": {"anyOf": [{"$ref": "#/$defs/repairTriggerDecision"}, {"type": "null"}]}
  }
}
