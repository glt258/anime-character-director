{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction_session.schema.json",
  "title": "CreativeInteractionSession",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "creation_mode",
    "current_stage",
    "current_gate",
    "status",
    "original_user_input",
    "explicit_user_constraints",
    "pending_constraint_updates",
    "delegated_fields",
    "locked_fields",
    "unresolved_fields",
    "character_explore_result",
    "selected_character_direction",
    "character_plan",
    "art_explore_result",
    "selected_art_direction",
    "visual_preference_sheet",
    "resolved_visual_preferences",
    "final_design",
    "design_gate_result",
    "compiled_prompt",
    "audit_log",
    "interaction_history",
    "created_at",
    "updated_at",
    "interaction_session_version"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "creation_mode": {"enum": ["QUICK", "AI_DECIDE", "USER_DECIDE"]},
    "current_stage": {"type": "string"},
    "current_gate": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "original_user_input": {"type": "string"},
    "explicit_user_constraints": {"type": "object"},
    "pending_constraint_updates": {"type": "object"},
    "delegated_fields": {"type": "array", "items": {"type": "string"}},
    "locked_fields": {"type": "object"},
    "unresolved_fields": {"type": "array", "items": {"type": "string"}},
    "character_explore_result": {"type": "array", "items": {"type": "object"}},
    "selected_character_direction": {"type": ["object", "null"]},
    "character_plan": {"type": ["object", "null"]},
    "art_explore_result": {"type": "array", "items": {"type": "object"}},
    "selected_art_direction": {"type": ["object", "null"]},
    "visual_preference_sheet": {"type": ["object", "null"]},
    "resolved_visual_preferences": {"type": "object"},
    "final_design": {"type": ["object", "null"]},
    "design_gate_result": {"type": ["object", "null"]},
    "compiled_prompt": {"type": ["object", "null"]},
    "audit_log": {"type": "array", "items": {"type": "object"}},
    "interaction_history": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "schema_version": {"type": "string"},
    "interaction_session_version": {"type": "string", "const": "1.0.0"}
  }
}
