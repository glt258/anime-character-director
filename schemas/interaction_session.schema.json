{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction_session.schema.json",
  "title": "CreativeInteractionSession",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "creation_mode",
    "current_stage",
    "current_gate",
    "status",
    "original_user_input",
    "explicit_user_constraints",
    "inherit_previous_visuals",
    "allowed_visual_inheritance",
    "blocked_context_sources",
    "visual_context_firewall_applied",
    "pending_constraint_updates",
    "delegated_fields",
    "locked_fields",
    "unresolved_fields",
    "character_explore_result",
    "selected_character_direction",
    "character_plan",
    "art_explore_result",
    "selected_art_direction",
    "visual_preference_sheet",
    "resolved_visual_preferences",
    "final_design",
    "design_gate_result",
    "compiled_prompt",
    "audit_log",
    "interaction_history",
    "created_at",
    "updated_at",
    "interaction_session_version"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "creation_mode": {"enum": ["QUICK", "AI_DECIDE", "USER_DECIDE"]},
    "current_stage": {"type": "string"},
    "current_gate": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "original_user_input": {"type": "string"},
    "design_seed": {"type": ["integer", "null"]},
    "explicit_user_constraints": {"type": "object"},
    "inherit_previous_visuals": {"type": "boolean", "default": false},
    "allowed_visual_inheritance": {"type": "array", "items": {"type": "string"}},
    "blocked_context_sources": {"type": "array", "items": {"type": "string"}},
    "visual_context_firewall_applied": {"type": "boolean", "const": true},
    "pending_constraint_updates": {"type": "object"},
    "delegated_fields": {"type": "array", "items": {"type": "string"}},
    "locked_fields": {"type": "object"},
    "unresolved_fields": {"type": "array", "items": {"type": "string"}},
    "character_explore_result": {"type": "array", "items": {"type": "object"}},
    "selected_character_direction": {"type": ["object", "null"]},
    "character_plan": {"type": ["object", "null"]},
    "art_explore_result": {"type": "array", "items": {"type": "object"}},
    "selected_art_direction": {"type": ["object", "null"]},
    "visual_preference_sheet": {"type": ["object", "null"]},
    "resolved_visual_preferences": {"type": "object"},
    "final_design": {"type": ["object", "null"]},
    "design_gate_result": {"type": ["object", "null"]},
    "compiled_prompt": {"type": ["object", "null"]},
    "generation_artifact": {
      "type": ["object", "null"],
      "properties": {
        "generation_id": {"type": "string"},
        "run_id": {"type": "string"},
        "image_path": {"type": "string"},
        "image_hash": {"type": "string"},
        "prompt_hash": {"type": "string"},
        "prompt_bundle_ref": {"type": "string"},
        "manifest_ref": {"type": "string"},
        "contract_ref": {"type": "string"},
        "mode": {"type": "string"},
        "design_seed": {"type": ["integer", "null"]},
        "created_at": {"type": "string"}
      }
    },
    "artifact_continuity": {"enum": ["strict_pending_generation", "strict_complete", "legacy_incomplete"]},
    "design_signature": {"type": ["object", "null"]},
    "novelty_review": {"type": ["object", "null"]},
    "novelty_history_snapshot": {"type": ["array", "null"], "items": {"type": "object"}},
    "novelty_candidate_reviews": {"type": "object"},
    "novelty_policy": {"type": "object"},
    "novelty_resolution_attempt": {"type": "integer", "minimum": 0},
    "novelty_status": {"type": ["string", "null"]},
    "human_override_novelty": {"type": "boolean"},
    "visual_adherence_review": {"type": ["object", "null"]},
    "original_image": {"type": ["string", "null"]},
    "original_visual_adherence_review": {"type": ["object", "null"]},
    "repair_attempts": {"type": "array", "items": {"type": "object"}},
    "best_artifact": {"type": ["object", "null"]},
    "repair_status": {"type": ["string", "null"]},
    "audit_log": {"type": "array", "items": {"type": "object"}},
    "interaction_history": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "schema_version": {"type": "string"},
    "interaction_session_version": {"type": "string", "enum": ["1.0.0", "1.1.0"]}
  }
}
